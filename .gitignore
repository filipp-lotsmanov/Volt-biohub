# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/

# --- Tooling caches ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.uv-cache/

# --- Data (never in git; see VOLT_DATA_DIR) ---
data/
tests/data/
*.zarr/
*.geff/
*.geff

# --- Run outputs ---
# `eda/` and `figures/` are unanchored, so they also cover reports/eda/ and
# reports/figures/ at any depth. reports/integrity/ is deliberately NOT ignored:
# integrity.json is a small committed artifact that records which pipeline
# assumptions held, and check_integrity.py exits non-zero when one breaks.
weights/
checkpoints/
predictions/
results/
eda/
runs/
figures/
logs/
videos/
wheels/
*.pt
*.pth
*.ckpt
submission.csv
submission*.csv
# Lives beside the data (see $VOLT_DATA_DIR), not in the repo. Regenerate it
# rather than sharing one: an embryo-grouped split is the only honest CV here.
dataset_splits.json
/kaggle_csvs

# Scratch scoring runs. `experiments.csv` at the repo root IS tracked -- it is
# the run ledger the experiment discipline requires -- but per-sweep sidecars
# written with --experiments elsewhere are not.
exp_*.csv
*_sweep.csv

# --- Local config / secrets ---
.env
*.local.toml
kaggle.json
.claude/settings.local.json

# --- Editors / OS ---
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
